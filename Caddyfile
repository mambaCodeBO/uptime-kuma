{$KUMA_DOMAIN} {
	# API pública da Status Page: liberada para o painel ler (CORS).
	@statusApi path /api/status-page/*
	handle @statusApi {
		reverse_proxy uptime-kuma:3001 {
			header_down Access-Control-Allow-Origin {$PAINEL_ORIGIN}
		}
	}

	# Interface do Kuma (admin).
	handle {
		reverse_proxy uptime-kuma:3001
	}
}
